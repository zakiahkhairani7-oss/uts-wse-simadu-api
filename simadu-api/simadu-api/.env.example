# Salin file ini menjadi .env lalu sesuaikan nilainya. JANGAN commit file .env.
PORT=3000
NODE_ENV=development

# Wajib diisi pada production. Minimal 32 karakter acak.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Masa berlaku token dalam detik (3600 = 1 jam)
JWT_EXPIRES_IN_SECONDS=3600

# Biaya hashing bcrypt (10-12 lazim)
BCRYPT_ROUNDS=10
